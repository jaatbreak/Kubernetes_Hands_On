Persistent Volume Creation 
-----------------------------------------------------------
apiVersion: v1
kind: PersistentVolume
metadata:
  name: local-pv
spec:
  capacity:
    storage: 1Gi #storage size
  accessModes:
  - ReadWriteOnce # Access modes 
  persistentVolumeClaimPolicy: Retain #Retain , Recycle or Delete 
  storageClassName: manual
  hostPath:
    path: /mnt/data

