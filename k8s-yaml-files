apiVersion: batch/v1
kind: Job
metadata:
  name: hello-job
  namespace: default
spec:
  completions: 1
  parallelism: 1
  backoffLimit: 3 #Number of try before considering the job failed
  template:
    metadata:
      labels:
        app: job
    spec:
      containers:
      - name: job-hello-container
        image: busybox:latest
        command: ["sh", "-c", "echo hello, dosto !! && sleep 30"]
        restartPolicy: Never 

---------------------------------------------------------
Cron Jobs
---------------------------------------------------------
       
apiVersion: batch/v1
kind: CronJob
metadata:
  name: example-cronjob
spec:
  schedule: "*/5 * * * *"  # Runs every 5 minutes
  jobTemplate:
    spec:
      template:
        spec:
          containers:
          - name: example-container
            image: busybox:latest
            command: ["sh", "-c", "date; echo Hello from Kubernetes CronJob!"]
          restartPolicy: OnFailure
  successfulJobsHistoryLimit: 3  # Keep logs of the last 3 successful runs
  failedJobsHistoryLimit: 1      # Keep logs of the last failed run
